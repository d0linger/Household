# Portainer variable reference. Use household init to populate fresh secrets.
# For an existing installation, retain its actual passwords and keys.
HOUSEHOLD_ORIGIN=https://household.example.org
HOUSEHOLD_PROXY_NETWORK=
HOUSEHOLD_TRUSTED_PROXIES=

# Bootstrap credentials and persistent secrets
HOUSEHOLD_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
HOUSEHOLD_OWNER_PASSWORD=
HOUSEHOLD_APP_PASSWORD=
HOUSEHOLD_CSRF_SECRET=
HOUSEHOLD_RATE_SECRET=
HOUSEHOLD_ENCRYPTION_KEY=
RESTIC_PASSWORD=
HOUSEHOLD_WEB_PUSH_VAPID_PRIVATE_KEY=

# Use an existing keyring here instead of HOUSEHOLD_ENCRYPTION_KEY, if applicable.
# HOUSEHOLD_ENCRYPTION_KEYRING=

# Defaults and additional app settings
# HOUSEHOLD_IMAGE=ghcr.io/d0linger/household:production
# HOUSEHOLD_NAME=Mein Haushalt
# HOUSEHOLD_ADMIN_USERNAME=admin
# HOUSEHOLD_WEB_PUSH_ENABLED=false
# HOUSEHOLD_WEB_PUSH_VAPID_CONTACT=mailto:operator@example.org
# HOUSEHOLD_OCR_ENABLED=false
# HOUSEHOLD_OFF_ENABLED=true
# HOUSEHOLD_OFF_USER_AGENT=
# HOUSEHOLD_UPDATE_CHECK=true
# HOUSEHOLD_PASSWORD_BREACH_CHECK=true
# HOUSEHOLD_METRICS_TOKEN=
# HOUSEHOLD_DB_MAX_CONNECTIONS=10

# IMAP (TLS) or Paperless-ngx document import
# HOUSEHOLD_DOCUMENT_IMAP_ADDRESS=imap.example.org:993
# HOUSEHOLD_DOCUMENT_IMAP_USER=scanner@example.org
# HOUSEHOLD_DOCUMENT_IMAP_PASSWORD=
# HOUSEHOLD_DOCUMENT_IMAP_MAILBOX=INBOX
# HOUSEHOLD_DOCUMENT_PAPERLESS_URL=https://paperless.example.org
# HOUSEHOLD_DOCUMENT_PAPERLESS_TOKEN=
# HOUSEHOLD_DOCUMENT_PAPERLESS_TAG=1

# Meter integrations over TLS
# HOUSEHOLD_METERS_HA_URL=https://homeassistant.example.org
# HOUSEHOLD_METERS_HA_TOKEN=
# HOUSEHOLD_METERS_MQTT_URL=mqtts://mqtt.example.org:8883
# HOUSEHOLD_METERS_MQTT_USER=
# HOUSEHOLD_METERS_MQTT_PASSWORD=

# Offsite backup. Set a separate password of at least 16 characters.
# New local and S3 or mounted backups are dated encrypted files. A restic
# REST destination uses Restic. Set this only to opt back into Restic writes.
# HOUSEHOLD_BACKUP_FORMAT=restic
# Choose an S3-compatible or restic REST URL, or mount a backup-only directory.
# HOUSEHOLD_S3_ENDPOINT=s3.example.org
# HOUSEHOLD_S3_BUCKET=s3-dp
# HOUSEHOLD_S3_PREFIX=household
# HOUSEHOLD_S3_REGION=us-east-1
# HOUSEHOLD_S3_USE_SSL=true
# HOUSEHOLD_S3_ACCESS_KEY=
# HOUSEHOLD_S3_SECRET_KEY=
# HOUSEHOLD_BACKUP_OFFSITE_PASSWORD=
# HOUSEHOLD_BACKUP_REST_USERNAME=
# HOUSEHOLD_BACKUP_REST_PASSWORD=

# Optional externally delivered backup alerts (ntfy, webhook or SMTP with TLS)
# HOUSEHOLD_ALERT_NAME=Household
# HOUSEHOLD_ALERT_NTFY_URL=
# HOUSEHOLD_ALERT_NTFY_TOKEN=
# HOUSEHOLD_ALERT_WEBHOOK_URL=
# HOUSEHOLD_ALERT_SMTP_ADDRESS=mail.example.org:587
# HOUSEHOLD_ALERT_SMTP_USER=
# HOUSEHOLD_ALERT_SMTP_PASSWORD=
# HOUSEHOLD_ALERT_SMTP_FROM=household@example.org
# HOUSEHOLD_ALERT_SMTP_TO=operator@example.org
