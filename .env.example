# Copy to .env and initialize secrets with scripts/initialize.ps1.
# Production requires HTTPS at a reverse proxy and its exact trusted CIDR.
HOUSEHOLD_ENV=production
HOUSEHOLD_ORIGIN=https://household.example.org
HOUSEHOLD_PORT=8100
HOUSEHOLD_TRUSTED_PROXIES=
HOUSEHOLD_ADMIN_USERNAME=admin
HOUSEHOLD_NAME=Mein Haushalt
# Optional product suggestions; reads only and disabled by default.
HOUSEHOLD_OFF_ENABLED=false
# Set your own application/version and operator contact before enabling.
HOUSEHOLD_OFF_USER_AGENT=
# Development only; uses the fixed OFF staging service.
HOUSEHOLD_OFF_STAGING=false
# Optional push needs compose.webpush.yaml and an explicitly generated secret.
HOUSEHOLD_WEB_PUSH_ENABLED=false
HOUSEHOLD_WEB_PUSH_VAPID_CONTACT=
