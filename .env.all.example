# Settings for compose.all.yaml (every optional service). Becomes .env through
#   sh scripts/initialize.sh --env-template .env.all.example   (or initialize.ps1 -EnvTemplate .env.all.example)
# The app receives every value here, so keep secrets out of this file.
# Secrets are files in .local/secrets/. The initializer generates all of them and leaves
# these empty for you to fill: document_imap_password, document_paperless_token,
# meters_ha_token, meters_mqtt_password, meters_ca.pem.
COMPOSE_FILE=compose.all.yaml

# Core (production needs HTTPS at a reverse proxy and its exact CIDR)
HOUSEHOLD_ORIGIN=https://household.example.org
HOUSEHOLD_TRUSTED_PROXIES=
HOUSEHOLD_PORT=8100
HOUSEHOLD_NAME=Mein Haushalt
HOUSEHOLD_ADMIN_USERNAME=admin

# Web Push
HOUSEHOLD_WEB_PUSH_VAPID_CONTACT=mailto:operator@example.org

# Documents: scanner folder (finished files renamed to *.ready.pdf/jpg/png), IMAP, Paperless
HOUSEHOLD_DOCUMENT_WATCH_HOST_DIR=/srv/household-scanner-inbox
HOUSEHOLD_DOCUMENT_IMAP_ADDRESS=imap.example.org:993
HOUSEHOLD_DOCUMENT_IMAP_USER=scanner@example.org
HOUSEHOLD_DOCUMENT_IMAP_MAILBOX=INBOX
HOUSEHOLD_DOCUMENT_PAPERLESS_URL=https://paperless.example.org
HOUSEHOLD_DOCUMENT_PAPERLESS_TAG=1            # numeric tag ID; only documents with this tag are imported

# Meters: Home Assistant and MQTT (TLS; the CA file verifies private certificates)
HOUSEHOLD_METERS_HA_URL=https://homeassistant.example.org
HOUSEHOLD_METERS_MQTT_URL=mqtts://mqtt.example.org:8883
HOUSEHOLD_METERS_MQTT_USER=household
