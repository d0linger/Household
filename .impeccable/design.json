      "description": "One visible label identifies its native field; reference search controls remain separate siblings within the field group.",
      "html": "<label class=\"ds-label\">Bezeichnung<input class=\"ds-input\" placeholder=\"Bezeichnung eingeben\"></label>",
      "css": ".ds-label{display:block;font:600 14px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;color:var(--ink,#271922)}.ds-input{display:block;width:100%;min-height:46px;margin-top:7px;padding:11px 12px;border:1px solid var(--control-border,#967365);border-radius:10px;background:var(--ground,#faf5ee);color:var(--ink,#271922);font:400 16px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;caret-color:var(--accent,#913f29)}.ds-input::placeholder{color:var(--muted,#725a61);opacity:1}.ds-input:focus{border-color:var(--accent,#913f29)}.ds-input:focus-visible{outline:3px solid var(--accent,#913f29);outline-offset:3px}@media(forced-colors:active){.ds-input{border-color:ButtonText}.ds-input:focus-visible{outline-color:Highlight}}"
    },
    {
      "name": "Current module navigation",
      "kind": "nav",
      "refersTo": "nav-current",
      "description": "Selected destination with a local outline icon.",
      "html": "<nav aria-label=\"Module\"><a class=\"ds-nav\" href=\"#shopping\" aria-current=\"page\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 3h3l3 13h11l3-10H6M9 21h.01M19 21h.01\"/></svg>Einkauf</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;min-height:48px;padding:12px 14px;border-radius:10px;background:var(--nav-selected,#c77358);color:var(--nav-selected-ink,#271922);font:550 14px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;text-decoration:none}.ds-nav svg{fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-nav:hover{background:var(--nav-selected,#c77358);color:var(--nav-selected-ink,#271922)}.ds-nav:focus-visible{outline:3px solid var(--nav-selected-ink,#271922);outline-offset:3px}@media(forced-colors:active){.ds-nav{outline:2px solid Highlight;outline-offset:-3px}.ds-nav:focus-visible{outline-color:Highlight}}"
    },
    {
      "name": "Active status badge",
      "kind": "chip",
      "refersTo": "badge-active",
      "description": "Text carries status alongside color.",
      "html": "<span class=\"ds-badge\">Aktiv</span>",
      "css": ".ds-badge{display:inline-block;background:var(--soft,#f3dfd2);border:1px solid var(--soft,#f3dfd2);color:var(--accent,#913f29);padding:4px 9px;border-radius:30px;font:650 10px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif}"
    },
    {
      "name": "Editing panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat tinted grouping for controls.",
      "html": "<section class=\"ds-panel\"><h2>Auf diesem Gerät</h2><p>Darstellung und lokale Einstellungen.</p></section>",
      "css": ".ds-panel{background:var(--surface,#fff9f3);color:var(--ink,#271922);border:0;border-radius:14px;padding:24px;box-shadow:none;font:16px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif}.ds-panel h2{font-size:21px;line-height:1.3;letter-spacing:-.45px;margin:0 0 12px}.ds-panel p{margin:0;color:var(--muted,#725a61)}@media(max-width:760px){.ds-panel{padding:20px;border-radius:13px}}@media(max-width:360px){.ds-panel{padding:16px}}@media(forced-colors:active){.ds-panel{outline:1px solid CanvasText}}"
    },
    {
      "name": "Record row",
      "kind": "custom",
      "refersTo": "record-row",
      "description": "A title and secondary detail on a divided canvas.",
      "html": "<a class=\"ds-row\" href=\"#record\"><span><strong>Eintrag</strong><small>Weitere Angaben</small></span></a>",
      "css": ".ds-row{display:flex;align-items:center;min-height:72px;gap:14px;padding:18px 24px;border-bottom:1px solid var(--line,#ddc6b9);color:var(--ink,#271922);text-decoration:none;font:16px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;font-variant-numeric:tabular-nums}.ds-row strong{display:block;font-size:15px;font-weight:600;overflow-wrap:anywhere}.ds-row small{display:block;margin-top:3px;font-size:14px;color:var(--muted,#725a61)}.ds-row:hover,.ds-row:focus-within{background:var(--soft,#f3dfd2)}.ds-row:focus-visible{outline:3px solid var(--accent,#913f29);outline-offset:3px}@media(max-width:760px){.ds-row{padding:16px;gap:12px}.ds-row strong{font-size:14px}.ds-row small{font-size:14px}}"
    },
    {
      "name": "Section navigation",
      "kind": "nav",
      "description": "Wrapping native links reach stable, focusable headings in settings and Recipe editors; targets are at least 44px high.",
      "html": "<nav class=\"ds-sections\" aria-label=\"Auf dieser Seite\"><a href=\"#modules\">Module</a><a href=\"#device\">Auf diesem Gerät</a><a href=\"#notifications\">Einkaufsmitteilungen</a></nav>",
      "css": ".ds-sections{display:flex;flex-wrap:wrap;gap:8px 20px;margin-block:0 24px;font:16px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif}.ds-sections a{display:inline-flex;align-items:center;min-height:44px;color:var(--accent,#913f29);text-underline-offset:3px}.ds-sections a:focus-visible{outline:3px solid var(--accent,#913f29);outline-offset:3px}@media(forced-colors:active){.ds-sections a:focus-visible{outline-color:Highlight}}",
      "refersTo": "section-nav"
    },
    {
      "name": "Secondary disclosure",
      "kind": "custom",
      "description": "Native disclosure groups secondary controls or Finance entry totals; Documents filters keep their selected values when collapsed.",
      "html": "<details class=\"ds-disclosure\"><summary>Zeitraum und Export</summary><p>Zusätzliche Filter und Exportoptionen.</p></details>",
      "css": ".ds-disclosure{font:16px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;color:var(--ink,#271922)}.ds-disclosure summary{min-height:var(--touch-target,44px);align-content:center;cursor:pointer;overflow-wrap:anywhere}.ds-disclosure summary:focus-visible{outline:3px solid var(--accent,#913f29);outline-offset:3px;border-radius:4px}.ds-disclosure p{max-width:75ch}@media(forced-colors:active){.ds-disclosure summary:focus-visible{outline-color:Highlight}}",
      "refersTo": "disclosure"
    },
    {
      "name": "Mobile action group",
      "kind": "custom",
      "description": "Shared action controls wrap from a 12rem flex basis on mobile and remain inside their container. Module-specific groups may retain scoped layouts.",
      "html": "<div class=\"ds-actions\" role=\"group\" aria-label=\"Aktionen\"><button type=\"button\">Auswahl anzeigen</button><button type=\"button\">Filter zurücksetzen</button></div>",
      "css": ".ds-actions{display:flex;flex-wrap:wrap;gap:12px;font:16px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif}.ds-actions button{min-height:44px;padding:10px 16px;border:1px solid var(--control-border,#967365);border-radius:10px;background:var(--surface,#fff9f3);color:var(--ink,#271922);font:inherit;font-weight:600;line-height:1.35;overflow-wrap:anywhere;cursor:pointer}.ds-actions button:hover{background:var(--soft,#f3dfd2);border-color:var(--accent,#913f29)}.ds-actions button:focus-visible{outline:3px solid var(--accent,#913f29);outline-offset:3px}.ds-actions button:active{filter:brightness(.94)}@media(max-width:760px){.ds-actions>*{flex:1 1 12rem;max-width:100%;min-width:0}}@media(forced-colors:active){.ds-actions button{border-color:ButtonText}.ds-actions button:focus-visible{outline-color:Highlight}}"
    }
  ],
  "narrative": {
    "northStar": "Warm Midnight",
    "overview": "Warm ivory or charcoal household workspaces, editorial serif page titles and independent plum/copper navigation. Pink light/dark remain available. Administration deliberately uses dark navy/mint in every consumer appearance. Only real authorized records and workflow states are shown.",
    "keyCharacteristics": [
      "Thin record dividers and bounded editing surfaces.",
      "Local serif page titles with system sans controls.",
      "Warm Midnight and Pink each follow light, dark or the system.",
      "Independent navy/mint administration and plum/copper right tray."
    ],
    "rules": [
      {
        "name": "The Shared Palette Rule",
        "body": "Consumer pages share the selected palette. Navigation and technical data panels have explicit paired roles; administration deliberately remains Midnight Atlas.",
        "section": "colors"
      },
      {
        "name": "The Visible Label Rule",
        "body": "Placeholder text supplements a field label; it never replaces that label or the field's validation message.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use a tinted surface to contain editing and a divider to separate records; reserve overlay depth for actual overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic CSS properties so every module follows all four palettes.",
      "Do keep labels, headings, native controls, focus, and selection legible in every theme.",
      "Do keep independent actions visibly separated and consequential actions explicit.",
      "Do preserve keyboard focus, native dialog behavior, and the reduced-motion preference.",
      "Do retain real empty, loading, error, conflict, and offline states."
    ],
    "donts": [
      "Don't restore the former green palette or hard-code light text on a light surface.",
      "Don't turn record collections or module settings into grids of floating cards.",
      "Don't add external fonts, frontend CDN dependencies, tracking scripts, or decorative gradients.",
      "Don't add decorative eyebrows or substitute text glyphs for the bundled outline icon system.",
      "Don't infer a passed operational or accessibility check from the existence of these design documents."
    ]
  }
}
